{
  "description": "Keep the Obsidian Codex plugin updated",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codex plugin marketplace upgrade vibe-coding",
            "statusMessage": "Updating vibe-coding marketplace..."
          },
          {
            "type": "command",
            "command": "codex plugin add obsidian-plugin@vibe-coding",
            "statusMessage": "Updating obsidian-plugin..."
          }
        ]
      }
    ]
  }
}
