{
  "description": "Remind to write tests for new Python files",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/tdd-reminder.sh"
          }
        ]
      }
    ]
  }
}
