{
  "description": "Codex hooks for request recaps and TDD reminders",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codex plugin marketplace upgrade vibe-coding",
            "statusMessage": "Updating vibe-coding marketplace..."
          },
          {
            "type": "command",
            "command": "codex plugin add general-plugin@vibe-coding",
            "statusMessage": "Updating general-plugin..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/tdd-reminder.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/request-recap.sh\""
          }
        ]
      }
    ]
  }
}
